# Variáveis do docker-compose do FinanceFlow.
# Copie para `.env` e ajuste. O `.env` NÃO é versionado.
#
# Este arquivo é só a INFRAESTRUTURA do compose. As integrações (Protheus, SMTP,
# JWT, admin inicial) ficam em `backend/.env` — ver `backend/.env.example`.
#
# Os dois ambientes rodam em hosts SEGREGADOS, a partir do mesmo repositório:
# em produção é `git clone` + este `.env` preenchido, sem editar arquivo algum.
#
#   dev  -> dev.financeflow.example.com  (203.0.113.20, vm-dev)
#   prod -> financeflow.example.com      (host de produção)

# Prefixo do ambiente (dev | hml | prod). Entra no nome dos containers, no nome
# dos routers do Traefik e no `APP_ENV` do backend, que decide se os usuários de
# teste do seed são criados.
ENV_PREFIX=prod

# Domínio publicado pelo Traefik neste host. É o que separa os ambientes.
APP_DOMAIN=financeflow.example.com

# Resolver de certificado do Traefik. VAZIO de propósito: o certificado é
# emitido pela CA do AD Windows e declarado no provider de arquivo do Traefik
# (/opt/docker/app-traefik/dynamic/tls-certs.yml). Só preencha
# (letsencrypt | cloudflare | tlsalpn) se o certificado passar a vir de ACME.
FRONTEND_CERTRESOLVER=

# Subnet da rede interna (frontend <-> backend <-> postgres). Fixa de propósito:
# sem isso o Docker sorteia a faixa e já colidiu com hosts reais da rede
# corporativa em 172.21. Só defina se 172.24.0.0/16 estiver ocupada NESTE host
# (confira: docker network ls | xargs docker network inspect).
# INTERNAL_SUBNET=172.24.0.0/16

# Banco. POSTGRES_PASSWORD é OBRIGATÓRIA: o compose recusa subir sem ela, em vez
# de usar um default fraco. Gere uma por host: openssl rand -base64 24
POSTGRES_USER=financeflow
POSTGRES_PASSWORD=
POSTGRES_DB=financeflow

# Porta do frontend no host, usada só pelo docker-compose.override.yml (rodar
# sem Traefik, ex.: Docker Desktop local). Ajuste se 8080 já estiver ocupada.
# FRONTEND_PORT=8080
