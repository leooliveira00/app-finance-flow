# Configuração do backend — copie para `.env` e ajuste os valores.
# Ver app/config.py para a lista completa e os defaults.

# --- Identificação contábil (Protheus) ---
# Empresa e filial usadas nos lançamentos de rateio.
EMPRESA=
FILIAL=

# === Protheus: DUAS BASES, separadas por EIXO (leitura x escrita) ===
# Não é "ambiente de dev x prod": por decisão de projeto CONSULTAMOS a base
# oficial (cadastro é dado real) e ESCREVEMOS na base de teste até o go-live.
#
# GO-LIVE (só este arquivo, sem tocar em código):
#   PROTHEUS_WRITE_BASE_URL   -> mesma URL da leitura (base oficial)
#   PROTHEUS_WRITE_VERIFY_SSL -> true
#   PROTHEUS_WRITE_AMBIENTE   -> producao
# O backend RECUSA subir em estados incoerentes (ex.: escrever na base oficial
# ainda rotulado "teste"). Ver app/config.py::_validar_base_de_escrita.

# --- LEITURA (consultas: colaboradores e dependentes) ---
# VAZIA DE PROPÓSITO: sem ERP configurado, o processamento usa o cadastro
# fictício de colaboradores (ColaboradorDemo, populado pelo seed) em vez do
# Protheus — é o que permite rodar a demonstração de ponta a ponta sem um ERP
# real. Preencha só se for apontar para um Protheus de verdade.
# A URL de cada empresa é CONCATENADA: {READ_BASE_URL}/{rest}/{caminho do endpoint}
# Ex.: https://protheus-demo.example.com:9090/rest15/uapi001/lista-colaboradores
PROTHEUS_READ_BASE_URL=
# O caminho do endpoint fica no código (`config.py`): ele é o contrato da API do
# Protheus, idêntico na base de teste e na oficial, então não é configuração de
# ambiente. Ainda pode ser sobreposto por variável em emergência.

# Um "rest" por empresa do grupo. O sistema varre TODOS e marca a empresa de
# cada colaborador conforme o rest. Mapa rest -> empresa (JSON).
# CONFIRME os rótulos (rest15 = Zenith?).
PROTHEUS_RESTS={"rest01": "Aurora", "rest02": "Vertex", "rest15": "Zenith"}

# Autenticação da LEITURA (a escrita herda estas se não tiver as suas).
# Use user/senha (basic) OU um token Bearer (se preenchido, tem prioridade).
PROTHEUS_USER=
PROTHEUS_PASSWORD=
# PROTHEUS_TOKEN=

# Rede da leitura (a paginação usa o parâmetro nPage automaticamente).
PROTHEUS_READ_TIMEOUT=30
# Deixe true; troque para false só se o certificado do Protheus for self-signed.
PROTHEUS_READ_VERIFY_SSL=true

# --- ESCRITA (inclusões: Autorização de Entrega, pré-nota, coparticipação) ---
# TODA inclusão vai para esta base. O rest vai na URL (rest02=Vertex, rest15=Zenith).
# Hoje: base de TESTE — não gera título na base oficial.
PROTHEUS_WRITE_BASE_URL=https://203.0.113.10:24001
# Rótulo do destino: teste | producao. NÃO muda comportamento de rede — torna o
# destino visível no log de subida, na auditoria da execução, no badge da UI e no
# prefixo [TESTE] do e-mail ao fiscal. Mentir aqui é o erro que a validação barra.
PROTHEUS_WRITE_AMBIENTE=teste
# A base de TESTE usa cert self-signed (false). Em "producao" o true é EXIGIDO.
PROTHEUS_WRITE_VERIFY_SSL=false
# Timeout (s) da escrita. Maior que o da leitura porque a inclusão escreve no ERP
# (gera o título) e pode demorar. Ajuste se preciso.
PROTHEUS_WRITE_TIMEOUT=120
# Credenciais próprias da base de escrita. Vazias -> herda PROTHEUS_USER/PASSWORD.
# PROTHEUS_WRITE_USER=
# PROTHEUS_WRITE_PASSWORD=
# PROTHEUS_WRITE_TOKEN=
# Paths dos endpoints (só mude se a API do ERP mudar). Ficam na base de ESCRITA —
# inclusive o GET de contratos: a AE referencia um contrato que precisa existir
# na mesma base onde o título será gravado.
# PROTHEUS_CONTRATOS_PATH=api/com/v1/partnership-agreement
# PROTHEUS_AE_PATH=api/com/v1/delivery-authorization
# Pré-nota (Zenith, rotina "pre_nota" — sem contrato). Produto fixo.
# PROTHEUS_PRENOTA_PATH=api/com/v1/incoming-pro-forma-invoice
# PROTHEUS_PRENOTA_PRODUTO=400366
# PROTHEUS_PRENOTA_FILIAL=01

# --- SMTP (notificação ao dep. fiscal com NF/boleto + nº dos títulos) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente; se vazio, usa SMTP_USER.
SMTP_FROM=
SMTP_TLS=true         # STARTTLS (porta 587)
SMTP_SSL=false        # SSL puro (porta 465) — use true e SMTP_PORT=465 se for o caso


# --- Autenticação (login + segregação por área) ---
# OBRIGATÓRIO e ESPECÍFICO DE CADA HOST: o backend recusa subir sem um segredo
# de 32+ caracteres (não há default). Segredo compartilhado entre dev e produção
# faria um token emitido em dev valer em produção.
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRA_MIN=480

# --- Administrador inicial (usado só em banco VAZIO) ---
# É como se entra num host novo. Em produção é obrigatório: com o banco vazio e
# sem estas variáveis, a subida falha em vez de criar credenciais de teste.
# Fora de produção (ENV_PREFIX != prod), o seed também cria admin/admin, rh/rh e
# operador/operador, que NÃO existem em produção.
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_ADMIN_NOME=Administrador

# --- CORS ---
# O frontend é servido na MESMA origem (o nginx faz proxy de /api/), então isto
# vale para chamadas diretas à API. Lista separada por vírgula.
#   dev:  http://localhost:3000,https://dev.financeflow.example.com
#   prod: https://financeflow.example.com
CORS_ORIGINS=https://financeflow.example.com

# --- Banco de dados (Postgres) ---
# No docker-compose a DATABASE_URL é montada a partir das credenciais do `.env`
# da RAIZ (POSTGRES_USER/PASSWORD/DB) e aponta para o serviço `postgres`. Não
# repita as credenciais aqui.
# Opcional: sobrepor a URL completa quando o Postgres é externo ao compose.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/financeflow
