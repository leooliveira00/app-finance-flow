# Variáveis do frontend. Copie para `frontend/.env` (fora do versionamento).
# Só valem para o dev server (`npm run dev`); em produção o nginx faz o proxy
# de /api e nenhuma variável daqui entra no build.

# VITE_API_PROXY: destino do proxy de /api no dev server do Vite.
# Padrão: http://localhost:8000 (backend rodando no host, ex.: via compose).
# Dentro da rede do compose, use http://backend:8000.
VITE_API_PROXY="http://localhost:8000"
